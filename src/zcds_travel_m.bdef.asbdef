managed implementation in class zbp_cds_travel_m unique;
strict ( 2 );

define behavior for ZCDS_TRAVEL_M alias Travel
persistent table zbh_travel_m
lock master
authorization master ( none )
etag master LastChangedAt
{
  create;
  update;
  delete;

  association _Booking { create; }

  field ( mandatory : create, readonly : update ) TravelId;
  field ( readonly ) TotalPrice;
  field ( readonly )
    CreatedBy,
    CreatedAt,
    LastChangedBy,
    LastChangedAt;

  validation checkDates on save { field BeginDate , EndDate ; create; }
  determination calculateTotalPrice on modify { field BookinfFee ; }
  //action ( features : instance ) acceptButton result [1] $self;
 //action acceptButton result [1] $self;
  mapping for zbh_travel_m
  {
    TravelId      = travel_id;
    AgencyId      = agency_id;
    CustomerId    = customer_id;
    BeginDate     = begin_date;
    EndDate       = end_date;
    BookinfFee    = bookinf_fee;
    TotalPrice    = total_price;
    CurrencyCode  = currency_code;
    Description   = description;
    OverallStatus = overall_status;
    CreatedBy     = created_by;
    CreatedAt     = created_at;
    LastChangedBy = lastchangedby;
    LastChangedAt = lastchangedat;
  }
}


define behavior for ZCDS_BOOKING_M_BH alias Booking
persistent table zbh_booking_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
{
  update;
  delete;

  association _Travel { }

  association _BookSupplement { create; }

  field ( readonly ) TravelId;

  field ( mandatory : create, readonly : update ) BookingId;

  field ( readonly ) LastChangedAt;

  mapping for zbh_booking_m
  {
    TravelId      = travel_id;
    BookingId     = booking_id;
    BookingDate   = booking_date;
    CustomerId    = customer_id;
    CarrierId     = carrier_id;
    ConnectionId  = connection_id;
    FlightDate    = flight_date;
    FlightPrice   = flight_price;
    CurrencyCode  = currency_code;
    BookingStatus = booking_status;
    LastChangedAt = last_changed_at;
  }
}


define behavior for ZCDS_BOOSPUL_M_BH alias BookingSupplement
persistent table zbh_boosupl_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
{
  update;
  delete;

  association _Travel { }

  association _Booking { }

  field ( readonly )
    TravelId,
    BookingId;

  field ( mandatory : create, readonly : update )
    BookingSupplementId;

  field ( readonly ) LastChangedAt;

  mapping for zbh_boosupl_m
  {
    TravelId             = travel_id;
    BookingId            = booking_id;
    BookingSupplementId  = booking_supplement_id;
    SupplementId         = supplement_id;
    Price                = price;
    CurrencyCode         = currency_code;
    LastChangedAt        = last_changed_at;
  }
}