        {
    id: 'BookingSupplements',
    purpose: #STANDARD,
    position: 40,
    type: #LINEITEM_REFERENCE,
    label: 'Booking Supplements',
    targetElement: '_BookSupplement'
}
    ]


    /* ========================================================
       TRAVEL ID
       ======================================================== */

