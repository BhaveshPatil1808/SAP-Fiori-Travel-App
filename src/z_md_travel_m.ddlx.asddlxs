  /* =========================================================
     DESCRIPTION
     ========================================================= */

  @UI.dataPoint: {
      qualifier: 'Description',
      title: 'Description'
  }

  @UI.fieldGroup: [
      {
          qualifier: 'TravelInformation',
          position: 40
      }
  ]

  @UI.lineItem: [
      {
          position: 90
      },
      {
          position: 40,
          qualifier: 'Accepted'
      }
  ]

  @UI.identification: [
      {
          position: 40
      }
  ]

  Description;


  /* =========================================================
