     ========================================================= */

  @UI.dataPoint: {
      qualifier: 'CustomerId',
      title: 'Customer'
  }

  @UI.fieldGroup: [
      {
          qualifier: 'TravelInformation',
          position: 30
      }
  ]

  @UI.lineItem: [
      {
          position: 30
      },
      {
          position: 30,
