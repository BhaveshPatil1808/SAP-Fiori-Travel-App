@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: 'Travel',
    typeNamePlural: 'Travels',
    typeImageUrl: 'sap-icon://travel-itinerary',

    title: {
        type: #STANDARD,
        value: 'TravelId'
    },

    description: {
        type: #STANDARD,
        value: 'Description'
    }
}

@UI.selectionVariant: [
    {
        qualifier: 'All',
        text: 'All'
    },
    {
        qualifier: 'Open',
        text: 'Open',
        filter: 'OverallStatus EQ "O"'
    },
    {
        qualifier: 'Accepted',
        text: 'Accepted',
        filter: 'OverallStatus EQ "A"'
    }
]

@UI.chart: [
    {
        qualifier: 'Accepted',
        chartType: #COLUMN,

        dimensions: [
            'AgencyId'
        ],

        measures: [
            'TotalPrice'
        ],

        dimensionAttributes: [
            {
                dimension: 'AgencyId',
                role: #CATEGORY
            }
        ],

        measureAttributes: [
            {
                measure: 'TotalPrice',
                role: #AXIS_1
            }
        ]
    }
]

@UI.presentationVariant: [
    {
        qualifier: 'PV_ALL',
        text: 'All',
        maxItems: 200,

        sortOrder: [
            {
                by: 'TravelId',
                direction: #DESC
            }
        ],

        requestAtLeast: [
            'TravelId'
        ],

        visualizations: [
            {
                type: #AS_LINEITEM
            }
        ]
    },

    {
        qualifier: 'PV_ACCEPTED',
        text: 'Accepted',
        maxItems: 200,

        visualizations: [
            {
                type: #AS_CHART,
                qualifier: 'Accepted'
            }
        ]
    }
]

@UI.selectionPresentationVariant: [
    {
        qualifier: 'BP_ALL',
        text: 'All',
        selectionVariantQualifier: 'All',
        presentationVariantQualifier: 'PV_ALL'
    },

    {
        qualifier: 'BP_OPEN',
        text: 'Open',
        selectionVariantQualifier: 'Open',
        presentationVariantQualifier: 'PV_ALL'
    },

    {
        qualifier: 'BP_ACCEPTED',
        text: 'Accepted',
        selectionVariantQualifier: 'Accepted',
        presentationVariantQualifier: 'PV_ACCEPTED'
    }
]
@UI.lineItem: [{criticality: 'OverallStatusCritically'}]
annotate entity Z_PV_TRAVEL_M with
{

  /* =========================================================
     TRAVEL FACETS
     ========================================================= */

  @UI.facet: [

      /* HEADER */

      {
          id: 'TravelTotalPrice',
          purpose: #HEADER,
          position: 10,
          type: #DATAPOINT_REFERENCE,
          targetQualifier: 'TotalPrice'
      },

      {
          id: 'TravelOverallStatus',
          purpose: #HEADER,
          position: 20,
          type: #DATAPOINT_REFERENCE,
          targetQualifier: 'OverallStatus'
      },

      /* TRAVEL INFORMATION */

      {
          id: 'TravelInformation',
          purpose: #STANDARD,
          position: 10,
          type: #FIELDGROUP_REFERENCE,
          label: 'Travel Information',
          targetQualifier: 'TravelInformation'
      },

      /* DATES */

      {
          id: 'TravelDates',
          purpose: #STANDARD,
          position: 20,
          type: #FIELDGROUP_REFERENCE,
          label: 'Travel Dates',
          targetQualifier: 'TravelDates'
      },

      /* PRICE */

      {
          id: 'PriceInformation',
          purpose: #STANDARD,
          position: 30,
          type: #FIELDGROUP_REFERENCE,
          label: 'Price Information',
          targetQualifier: 'PriceInformation'
      },

      /* ADMIN */

      {
          id: 'AdministrativeInformation',
          purpose: #STANDARD,
          position: 40,
          type: #FIELDGROUP_REFERENCE,
          label: 'Administrative Information',
          targetQualifier: 'AdministrativeInformation'
      },

      /* =====================================================
         IMPORTANT: BOOKINGS
         ===================================================== */

      {
  id: 'Bookings',
  purpose: #STANDARD,
  position: 50,
  type: #LINEITEM_REFERENCE,
  label: 'Bookings',
  targetElement: '_Booking'
  }
  ]


  /* =========================================================
     TRAVEL ID
     ========================================================= */

  @UI.dataPoint: {
      qualifier: 'TravelId',
      title: 'Travel ID'
  }

  @UI.fieldGroup: [
      {
          qualifier: 'TravelInformation',
          position: 10
      }
  ]

  @UI.lineItem: [
      {
          position: 10
      },
      {
          position: 10,
          qualifier: 'Accepted'
      }
  ]

  @UI.identification: [
      {
          position: 10
      }
  ]

  @UI.selectionField: [
      {
          position: 5
      }
  ]

  TravelId;


  /* =========================================================
     AGENCY
     ========================================================= */

  @UI.dataPoint: {
      qualifier: 'AgencyId',
      title: 'Travel Agency'
  }

  @UI.fieldGroup: [
